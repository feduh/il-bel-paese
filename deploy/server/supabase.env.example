# Valori da cambiare nel file /opt/supabase/docker/.env (copiato da .env.example di Supabase).
# Questo file NON contiene segreti: i valori segnati <...> si generano sul server e restano solo lì.
# Le chiavi (JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, POSTGRES_PASSWORD, ecc.) si generano con
# lo script ufficiale:  sh ./utils/generate-keys.sh   (vedi piano, passaggio "Configurazione").

# ---- Dominio ---------------------------------------------------------------
# Usati da Caddy (docker-compose.override.yml)
SITE_DOMAIN=<ilbelpaese.it>
ACME_EMAIL=<indirizzo per gli avvisi di Let's Encrypt>

# Indirizzi pubblici: sito e API sono sullo stesso dominio
SUPABASE_PUBLIC_URL=https://<ilbelpaese.it>
API_EXTERNAL_URL=https://<ilbelpaese.it>/auth/v1
SITE_URL=https://<ilbelpaese.it>
# Pagine a cui i link nelle email possono riportare (reset password, invito)
ADDITIONAL_REDIRECT_URLS=https://<ilbelpaese.it>/reset-password,https://<ilbelpaese.it>/area-personale

# ---- Accesso: solo su invito -----------------------------------------------
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ---- Email (indirizzo Starter incluso con il dominio Infomaniak) -----------
SMTP_ADMIN_EMAIL=<noreply@ilbelpaese.it>
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=<noreply@ilbelpaese.it>
SMTP_PASS=<password dell'indirizzo email>
SMTP_SENDER_NAME=Il Bel Paese

# ---- Funzioni ----------------------------------------------------------------
# Le nostre funzioni verificano da sole l'utente (auth.getUser); il router non deve bloccarle
FUNCTIONS_VERIFY_JWT=false

# ---- Studio ------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=Il Bel Paese
STUDIO_DEFAULT_PROJECT=Il Bel Paese
# Studio è raggiungibile solo via tunnel SSH, ma la password va comunque cambiata
DASHBOARD_USERNAME=<nome a scelta>
DASHBOARD_PASSWORD=<password lunga>
